# ============================================================
# Smart Campus Multi-Agent System - configuration
# Copy this file to .env and fill in AT LEAST ONE API key.
# With zero keys the system still works (rule-based fallback).
# ============================================================

# --- Free LLM providers (all have free tiers, no card needed) ---
# Google AI Studio:  https://aistudio.google.com/apikey   (recommended)
GOOGLE_API_KEY=
# Groq:              https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter:        https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Provider fallback order (first available wins, others are fallbacks)
LLM_PROVIDER_ORDER=gemini,groq,openrouter
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Behaviour ---
# Proposal score (0..1) needed to auto-apply a reallocation without a human
AUTO_APPLY_THRESHOLD=0.75
# Negotiation rounds before the Coordinator gives up / escalates
MAX_NEGOTIATION_ROUNDS=3
# Auto-resolve conflicts in the background loop (1=yes)
AUTO_RESOLVE=1
SCAN_INTERVAL_SEC=60
BACKGROUND_TASKS=1
SEED_ON_START=1

# Agent-to-agent transport: inline (in-process) or http (REST calls)
AGENT_TRANSPORT=inline

# --- Server ---
HOST=127.0.0.1
PORT=8000
CAMPUS_DB=campus.db
